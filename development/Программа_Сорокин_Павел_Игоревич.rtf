\par \uc0\u1042 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1090 \uc0\u1077 \uc0\u1086 \uc0\u1088 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1101 \uc0\u1090 \uc0\u1072 \uc0\u1087  (\uc0\u1095 \uc0\u1072 \uc0\u1089 ): 2}
\par \pard \ql {\fs24 \f0 \b 
\par 2. \uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1101 \uc0\u1090 \uc0\u1072 \uc0\u1087 :}
\par \pard \ql {\fs24 \f0 \b 
\par 2.1. \uc0\u1047 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1081 (\uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1081 ) \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1103 \uc0\u1093 .
\par 2.2. \uc0\u1047 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1081 (\uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1081 ) \uc0\u1074  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1103 \uc0\u1093 .}
\par \pard \ql {\fs24 \f0 
\par \uc0\u1042 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1086 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1101 \uc0\u1090 \uc0\u1072 \uc0\u1087  (\uc0\u1095 \uc0\u1072 \uc0\u1089 ): 2}
\par \pard \ql {\fs24 \f0 
