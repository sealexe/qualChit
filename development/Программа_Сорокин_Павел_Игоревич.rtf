\par \pard \ql {\fs24 \f0 \uc0\u1044 \uc0\u1072 \uc0\u1090 \uc0\u1072  \uc0\u1080  \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1101 \uc0\u1082 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1072 : 109428, \uc0\u1075 . \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , \uc0\u1091 \uc0\u1083 . \uc0\u1057 \uc0\u1090 \uc0\u1072 \uc0\u1093 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103 , \uc0\u1076 . 20, \uc0\u1089 \uc0\u1090 \uc0\u1088 . 11\uc0\u1072 , 18.03.2026}
